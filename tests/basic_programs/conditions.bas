10 REM Conditional Test Program
20 REM Tests IF-THEN statements
30 PRINT "CONDITIONAL TESTS"
40 PRINT "================="
50 REM Simple conditions
60 LET A = 10
70 IF A > 5 THEN PRINT "A IS GREATER THAN 5"
80 IF A < 15 THEN PRINT "A IS LESS THAN 15"
90 IF A = 10 THEN PRINT "A EQUALS 10"
100 REM Conditions with variables
110 LET X = 20
120 LET Y = 30
130 IF X < Y THEN PRINT "X IS LESS THAN Y"
140 IF Y > X THEN PRINT "Y IS GREATER THAN X"
150 PRINT "END OF CONDITIONAL TESTS"
