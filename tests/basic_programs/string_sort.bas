100 DIM A$(5)
110 FOR I=1 TO 5:READ A$(I):NEXT I
120 F=0:I=1
130 IF A$(I)<=A$(I+1) THEN 170
140 T$=A$(I+1)
150 A$(I+1)=A$(I):A$(I)=T$
160 F=1
170 I=I+1:IF I<5 GOTO 130
190 IF F THEN 120
200 FOR I=1 TO 5:PRINT A$(I):NEXT I
220 DATA DOG,APPLE,CAT,BASIC,FOO,SEATTLE
240 DATA RANDOM,BISCUIT,BELLEVUE,SEATTLE,BYTE,BIT,SUGAR